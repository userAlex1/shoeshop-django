# Copy this file to .env and fill in your real values. Never commit .env.

SECRET_KEY=change-this-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- M-Pesa Daraja sandbox credentials ---
# Get these from https://developer.safaricom.co.ke -> My Apps
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_sandbox_passkey_from_test_credentials_page
# Must be public HTTPS - use ngrok in dev, e.g. https://abcd1234.ngrok-free.app/payments/mpesa/callback/
MPESA_CALLBACK_URL=https://your-ngrok-or-domain/payments/mpesa/callback/

# --- Paystack (cards / bank) ---
# Get these from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
